name: Debian amd64 Test Build

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - .github/workflows/debian-amd64-test.yml
      - Cargo.toml
      - Cargo.lock
      - src/**
      - ui/**
      - assets/meatshell.desktop
      - assets/icon@512.png

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends build-essential pkg-config cmake \
            libfontconfig1-dev libfreetype6-dev libxcb1-dev libxcb-render0-dev \
            libxcb-shape0-dev libxcb-xfixes0-dev libxkbcommon-dev libxkbcommon-x11-dev \
            libwayland-dev libgl1-mesa-dev libegl1-mesa-dev libgtk-3-dev libudev-dev
      - name: Build
        run: cargo build --release --locked
      - name: Package DEB
        run: |
          set -eu
          root=deb-root
          install -Dm755 target/release/meatshell "$root/usr/bin/meatshell"
          install -Dm644 assets/meatshell.desktop "$root/usr/share/applications/meatshell.desktop"
          install -Dm644 assets/icon@512.png "$root/usr/share/icons/hicolor/512x512/apps/meatshell.png"
          install -Dm644 THIRD_PARTY_NOTICES.md "$root/usr/share/doc/meatshell/THIRD_PARTY_NOTICES.md"
          install -d "$root/DEBIAN"
          version=$(sed -n '/^\[package\]/,/^\[/ s/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)
          cat > "$root/DEBIAN/control" <<EOF
          Package: meatshell
          Version: ${version}
          Section: net
          Priority: optional
          Architecture: amd64
          Maintainer: MeatShell contributors
          Depends: libc6, libfontconfig1, libfreetype6, libgtk-3-0, libx11-6, libxcb1, libxkbcommon0
          Homepage: https://github.com/yituorou/meatshell
          Description: Lightweight SSH, SFTP, and terminal client
           MeatShell is a cross-platform terminal client written in Rust and Slint.
          EOF
          dpkg-deb --root-owner-group --build "$root" "meatshell-v${version}-linux-amd64-test.deb"
      - uses: actions/upload-artifact@v4
        with:
          name: deb-amd64-test
          path: meatshell-v*-linux-amd64-test.deb
          retention-days: 7
